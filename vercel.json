{
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run db:generate:prod --workspace @vivass/api && npm run build --workspace @vivass/shared && npm run build --workspace @vivass/api && npm run build --workspace @vivass/web",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/index.ts": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "node_modules/.prisma/**,apps/api/dist/**,packages/shared/dist/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
