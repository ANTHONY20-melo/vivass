# Ambiente de desenvolvimento local do VIVASS.
# Copie para .env e ajuste. NUNCA versione o .env real.

NODE_ENV=development
PORT=3333
DATABASE_URL="file:./dev.db"

# Obrigatório, mínimo 32 caracteres. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-segredo-aleatorio-de-ao-menos-32-caracteres

# Origem do front em desenvolvimento (usada apenas em log/CORS explícito).
WEB_ORIGIN=http://localhost:5173

# true somente atrás de HTTPS (produção).
COOKIE_SECURE=false
