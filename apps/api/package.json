{
  "name": "@vivass/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:generate:prod": "prisma generate --schema prisma-postgres/schema.prisma",
    "db:migrate:prod": "prisma migrate deploy --schema prisma-postgres/schema.prisma",
    "db:seed:prod": "tsx prisma/seed.ts",
    "schema:check": "node ../../scripts/check-schema-sync.cjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/static": "^11.0.0",
    "@prisma/client": "^6.7.0",
    "@types/node": "^22.10.0",
    "@vivass/shared": "*",
    "dotenv": "^16.4.5",
    "exceljs": "^3.4.0",
    "fastify": "^5.4.0",
    "fastify-plugin": "^5.0.1",
    "jose": "^6.0.0",
    "pdfkit": "^0.21.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/pdfkit": "^0.17.7",
    "prisma": "^6.7.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^5.1.2"
  }
}
